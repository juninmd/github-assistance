# Example .env file for local development
# NEVER commit this file to Git!

# ── Required ──────────────────────────────────────────────────────────────

# GitHub Personal Access Token (scopes: repo, workflow)
GITHUB_TOKEN=ghp_your_token_here

# Jules API Key (get from Jules dashboard)
JULES_API_KEY=your_jules_key_here

# ── AI Providers (at least one required for AI-powered agents) ────────────

# Gemini API Key (from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_key_here

# OpenAI API Key (if using OpenAI provider)
OPENAI_API_KEY=

# LiteLLM API Key (if using LiteLLM provider)
LITELLM_API_KEY=

# LiteLLM API base URL (K8s internal default; override for local dev)
# LITELLM_API_BASE=http://localhost:4000

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama timeout in milliseconds (default: 300)
OLLAMA_TIMEOUT_MS=300000

# OpenAI base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI enablement and model selection
ENABLE_AI=false
AI_PROVIDER=ollama
AI_MODEL=qwen3:1.7b

# ── GitHub Configuration ─────────────────────────────────────────────────

# GitHub owner/organization to monitor
GITHUB_OWNER=juninmd

# Fallback token for clone operations (GH_PAT is used if GITHUB_TOKEN is unavailable)
GH_PAT=

# Repository allowlist path
REPOSITORY_ALLOWLIST_PATH=config/repositories.json

# ── Telegram Notifications ───────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Agent Toggles (true/false) ───────────────────────────────────────────

# Names consumed by src/config/settings.py (from_env).
PM_AGENT_ENABLED=true
UI_AGENT_ENABLED=true
DEV_AGENT_ENABLED=true
PR_ASSISTANT_ENABLED=true
SECURITY_SCANNER_ENABLED=true
CI_HEALTH_ENABLED=true
PR_SLA_ENABLED=true
JULES_TRACKER_ENABLED=true
SECRET_REMOVER_ENABLED=true
PROJECT_CREATOR_ENABLED=true
BRANCH_CLEANER_ENABLED=true
INTELLIGENCE_AGENT_ENABLED=true
README_CURATOR_ENABLED=true
CODE_REVIEWER_ENABLED=true
DEPENDENCY_MANAGER_ENABLED=true

# Minimum README rubric score (0-100); below it the curator opens an improvement PR.
README_MIN_SCORE=80

# ── Senior Developer Agent ───────────────────────────────────────────────

# Enable burst mode (uses Jules sessions for high-impact tasks)
SENIOR_DEVELOPER_ENABLE_BURST=true
# Daily repository analysis limit
SENIOR_DEVELOPER_DAILY_REPO_LIMIT=5

# ── Jules Client Tuning ──────────────────────────────────────────────────

JULES_TIMEOUT_SECONDS=1800
JULES_WAIT_SECONDS=14400
JULES_RETRY_ATTEMPTS=5
JULES_BURST_MAX_ACTIONS=3
JULES_BURST_TRIGGER_HOUR_UTC_MINUS_3=2
JULES_DAILY_SESSION_LIMIT=10

# ── PR Assistant / Conflict Resolver ─────────────────────────────────────

CONFLICT_AI_PROVIDER=gemini
CONFLICT_AI_MODEL=gemini-2.5-flash
CONFLICT_AI_FALLBACK_ENABLED=true
PIPELINE_FIX_ENABLED=true
PIPELINE_FIX_MAX_ATTEMPTS=3

# ── Advisory PR Review ───────────────────────────────────────────────────
# LiteLLM diff review is advisory but ON by default (set false to disable).
LLM_REVIEW_ENABLED=true
# Deep opencode review (clones the PR + runs opencode). ON by default: the merge gate needs its verdict.
OPENCODE_REVIEW_ENABLED=true
# Merge only after an explicit APPROVE of the bot review on the current head SHA (needs OPENCODE_REVIEW_ENABLED=true).
MERGE_REQUIRE_REVIEW=true
# Homologation: run reviews end-to-end but write nothing (no comment/label/status/push).
REVIEW_DRY_RUN=false
# Lowest finding severity that blocks the merge via the github-assistance/review gate.
REVIEW_GATE_MIN_SEVERITY=error
# Model for the diff-only LiteLLM fallback; must be allowed by LITELLM_API_KEY.
LLM_REVIEW_MODEL=cloud/auto
# Auto-fix: apply review fixes and push to the PR branch (disabled in dry-run).
REVIEW_AUTOFIX_ENABLED=true
# Sugestões não bloqueantes de stack obsoleta e README desatualizado na revisão
REVIEW_ADVISORIES=true
# Comentários inline (warn/error) na linha do diff; máx. de pacotes de arquivos revisados por PR
REVIEW_INLINE_ENABLED=true
REVIEW_MAX_PACKAGES=4

# ── Secret Remover ───────────────────────────────────────────────────────

SECRET_REMOVER_AI_PROVIDER=gemini
SECRET_REMOVER_AI_MODEL=gemini-2.5-flash
RESULTS_DIR=results

# ── Webhook Server (GitHub App) ──────────────────────────────────────────

GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Bearer token for /api/* (jobs, explain). Unset = API disabled (403).
ADMIN_API_TOKEN=
# Serve the control-room UI at /dashboard/ (static shell; data still needs the token).
DASHBOARD_ENABLED=true
WEBHOOK_DATABASE_PATH=data/webhooks.db
AUTOMATION_MODE=observe
# Delivery payloads older than this are deleted, then the DB is VACUUMed.
WEBHOOK_PURGE_ENABLED=true
WEBHOOK_RETENTION_DAYS=3
WEBHOOK_PURGE_INTERVAL_SECONDS=21600

# Durable queue / worker
WORKER_ENABLED=true
QUEUE_POLL_INTERVAL_SECONDS=15
QUEUE_LEASE_SECONDS=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_SECONDS=60
MAX_CONCURRENT_WORKERS=1
# Simulation mode: PR Assistant records decisions but never writes externally.
SIMULATION_MODE=false

# Autonomy / prioritization
AUTONOMY_POLICY_PATH=config/autonomy.json
PRIORITIES_PATH=config/priorities.json

# ── Scheduling ───────────────────────────────────────────────────────────

AGENT_RUN_INTERVAL_HOURS=24

# ── opencode Execution Tuning (seconds) ──────────────────────────────────

OPENCODE_MODELS_TIMEOUT_SECONDS=20
OPENCODE_CLONE_TIMEOUT_SECONDS=120
OPENCODE_WARMUP_TIMEOUT_SECONDS=180
OPENCODE_RUN_TIMEOUT_SECONDS=1200
OPENCODE_PUSH_TIMEOUT_SECONDS=120
OPENCODE_RUN_MAX_ATTEMPTS=2

# ── opencode Secret Guardrails ───────────────────────────────────────────
# opencode child processes never receive credential env vars (deny-list +
# any name ending in _KEY/_TOKEN/_SECRET/_PAT, minus the keep-list).
# Pushes of agent-written content are also blocked when a scan of the clone
# finds a token pattern or a live env credential in any file.

# Extra env vars to strip before spawning opencode (comma-separated).
OPENCODE_ENV_DENY=
# Comma-separated env vars to KEEP even if they match the deny rules
# (LITELLM_API_KEY is kept by default so opencode reaches its model provider).
OPENCODE_ENV_KEEP=

# ── Misc ─────────────────────────────────────────────────────────────────

NO_COLOR=true
DEBUG=false

# ── Cost control ──────────────────────────────────────────────────────────
# Max estimated LLM tokens (in+out) per process run; 0/unset = unlimited.
# Cached answers are still served after the budget is spent.
# AI_TOKEN_BUDGET=200000
# Optional non-secret overrides file (TOML [env] table); real env vars win.
# FEATURES_FILE=config/features.toml
# AI_USAGE_LOG=data/ai_usage.jsonl   # per-agent token ledger; view with `pr-insight cost`

# ── Tuning knobs read outside settings.py (documented here; override via env or features.toml) ──
# AI_CACHE_MAX_ENTRIES=256
# AI_CACHE_PATH=                      # sqlite path: share the LLM cache across runs
# CONFLICT_HUNK_THRESHOLD=
# CONFLICT_MAX_FILES=
# CONFLICT_OPENCODE_ENABLED=
# CONFLICT_OPENCODE_TIMEOUT=
# DEPENDENCY_DRY_RUN=
# GITLEAKS_CONFIG=config/gitleaks.toml
# LITELLM_MODEL=
# OLLAMA_MODEL=
# OPENCODE_MODEL=
# OPENCODE_REVIEW_MODEL=
# TOKENIX_ENABLED=true
# TOKENIX_BIN=
# TOKENIX_HOME=
# TOKENIX_INDEX_TIMEOUT_SECONDS=120
# OPENCODE_REVIEW_MAX_FREE_MODELS=
# OPENCODE_REVIEW_TIMEOUT=
# LLM_REVIEW_SUBAGENTS_MIN_CHARS=
# PIPELINE_FIX_UPDATE_BRANCH=true
# PR_FIX_VALIDATE=auto
# PR_FIX_VALIDATE_TIMEOUT=300
# PUSH_GUARD_GITLEAKS=auto
# PUSH_GUARD_SAST=auto
# PUSH_GUARD_SEMGREP_CONFIG=p/security-audit
# PUSH_GUARD_TRIVY_SCANNERS=secret,misconfig
# PUSH_GUARD_TRUFFLEHOG_VERIFY=
# README_MAX_AGE_DAYS=
# REDIS_URL=
# REDIS_HOST=
# REDIS_PASSWORD=
# REVIEW_GATE_ENABLED=true
# Jules cleaner / client limits
# JULES_CLEANER_MAX_AGE_DAYS=3
# JULES_CLEANER_PAGE_SIZE=100
# JULES_CLEANER_TIMEOUT_SECONDS=
# JULES_MAX_ACTIVITIES=500
# JULES_MAX_ACTIVITY_PAGES=50
# PR Assistant: review/fix tuning
# LLM_REVIEW_SUBAGENTS=false
# OPENCODE_REVIEW_MAX_PER_RUN=4
# OPENCODE_REVIEW_WAIT_SECONDS=120
# PIPELINE_FIX_TIMEOUT=1200
# PIPELINE_FIX_FREE_TIMEOUT=600
# PIPELINE_FIX_MAX_FREE_MODELS=2
# PIPELINE_FIX_REQUIRE_REVIEW=false
# REVIEW_REQUIRE_EVIDENCE=true
# Logging / pacing
# LOG_LEVEL=INFO
# SENIOR_DEVELOPER_REPO_DELAY_MS=1000
# PORT=8080
